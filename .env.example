# LLM / strategic planning
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me

# Jev / System One tactical decision layer
TYPESAFE_API_KEY=replace-me
# JEV_MODEL=jev-latest
# JEV_INTERVAL_MS=400
# JEV_TIMEOUT_MS=3000
# JEV_CONFIDENCE_FLOOR=0.20
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Gameplay-only mode (npm run start:gameplay)
# GPT is used only for slow strategic planning; Jev selects immediate typed actions.
# STRATEGIC_MODEL=gpt-5.6-terra
# BOT_USERNAME=AI_Rei
# GAMEPLAY_STATUS_INTERVAL_MS=2000
# GAMEPLAY_STALL_THRESHOLD_MS=20000
# GAMEPLAY_STALL_ALERT_COOLDOWN_MS=15000
# GAMEPLAY_VIEWER_ENABLED=1
# GAMEPLAY_VIEWER_PORT=3007
# GAMEPLAY_VIEWER_AUTO_OPEN=1

# YouTube — 配信枠自動管理（3つそろえれば Live API で枠作成）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# 上記が空のとき必須: 固定ストリームキー
# YOUTUBE_STREAM_KEY=
YOUTUBE_CHANNEL_ID=

# 任意（自動管理時）
# YOUTUBE_CATEGORY_ID=20
# YOUTUBE_TITLE_TEMPLATE=【AI Minecraft】星守レイのハードコア生存実験 #Gen{世代番号}
# YOUTUBE_DESCRIPTION_TEMPLATE=第{世代番号}世代\n最高: {最高記録}\n累計死亡: {累計死亡}

# Minecraft
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565

# VOICEVOX
VOICEVOX_HOST=http://localhost:50021
# VOICEVOX_SPEAKER_ID=23

# Database
# gameplay-only mode defaults to ./data/gameplay.db when DB_PATH is unset
DB_PATH=./data/state.db

# Dashboard
DASHBOARD_PORT=8080
