{
  "name": "ai-minecraft",
  "version": "0.1.0",
  "private": true,
  "description": "AI VTuber 星守レイ - Minecraft ハードコア自動配信システム",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:gameplay": "tsx src/gameplay/jevMain.ts",
    "dev": "tsx watch src/index.ts",
    "dev:gameplay": "tsx watch src/gameplay/jevMain.ts",
    "mc:setup": "bash scripts/mc-setup-local.sh",
    "mc:start": "bash scripts/mc-start-local.sh",
    "mc:stop": "bash scripts/mc-stop-local.sh",
    "mc:reset": "bash scripts/mc-reset-local.sh",
    "mc:status": "bash scripts/mc-status-local.sh",
    "test": "jest --runInBand",
    "test:parallel": "jest",
    "test:serial": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "mineflayer": "^4.35.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
